CREATE TABLE chat_message (
    id TEXT NOT NULL PRIMARY KEY,
    thread_id TEXT NOT NULL,
    sender_wallet TEXT NOT NULL,
    recipient_wallet TEXT NOT NULL,
    content TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE pending_message (
    id TEXT NOT NULL PRIMARY KEY,
    thread_id TEXT NOT NULL,
    sender_wallet TEXT NOT NULL,
    recipient_wallet TEXT NOT NULL,
    local_payload TEXT NOT NULL,
    status TEXT NOT NULL,
    retry_count INTEGER NOT NULL,
    last_error TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE transaction_record (
    idempotency_key TEXT NOT NULL PRIMARY KEY,
    tx_hash TEXT,
    asset_id TEXT NOT NULL,
    chain_id INTEGER NOT NULL,
    amount TEXT NOT NULL,
    status TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE idempotency_record (
    idempotency_key TEXT NOT NULL PRIMARY KEY,
    wallet_address TEXT NOT NULL,
    endpoint TEXT NOT NULL,
    payload_hash TEXT NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE TABLE token_metadata (
    asset_id TEXT NOT NULL PRIMARY KEY,
    symbol TEXT NOT NULL,
    decimals INTEGER NOT NULL,
    name TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE staking_position (
    id TEXT NOT NULL PRIMARY KEY,
    wallet_address TEXT NOT NULL,
    chain_id INTEGER NOT NULL,
    asset_id TEXT NOT NULL,
    amount TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE device_token (
    token TEXT NOT NULL PRIMARY KEY,
    platform TEXT NOT NULL,
    registered_at INTEGER NOT NULL
);

CREATE TABLE contact (
    owner_wallet TEXT NOT NULL,
    contact_wallet TEXT NOT NULL,
    alias TEXT,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    last_interaction_at INTEGER NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (owner_wallet, contact_wallet)
);

upsertDeviceToken:
INSERT OR REPLACE INTO device_token(token, platform, registered_at)
VALUES (?, ?, ?);

selectDeviceToken:
SELECT * FROM device_token
LIMIT 1;

clearDeviceTokens:
DELETE FROM device_token;

upsertTransactionRecord:
INSERT OR REPLACE INTO transaction_record(
    idempotency_key,
    tx_hash,
    asset_id,
    chain_id,
    amount,
    status,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteTransactionRecord:
DELETE FROM transaction_record
WHERE idempotency_key = ?;

selectTransactionRecordByIdempotencyKey:
SELECT * FROM transaction_record
WHERE idempotency_key = ?
LIMIT 1;

selectTransactionRecords:
SELECT * FROM transaction_record
ORDER BY updated_at DESC;

upsertChatMessage:
INSERT OR REPLACE INTO chat_message(
    id,
    thread_id,
    sender_wallet,
    recipient_wallet,
    content,
    status,
    created_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectChatMessagesByThread:
SELECT * FROM chat_message
WHERE thread_id = ?
ORDER BY created_at ASC;

upsertPendingMessage:
INSERT OR REPLACE INTO pending_message(
    id,
    thread_id,
    sender_wallet,
    recipient_wallet,
    local_payload,
    status,
    retry_count,
    last_error,
    created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePendingMessage:
DELETE FROM pending_message
WHERE id = ?;

selectPendingMessagesByThread:
SELECT * FROM pending_message
WHERE thread_id = ?
ORDER BY created_at ASC;

selectAllPendingMessages:
SELECT * FROM pending_message
ORDER BY created_at ASC;

upsertContact:
INSERT OR REPLACE INTO contact(
    owner_wallet,
    contact_wallet,
    alias,
    is_favorite,
    last_interaction_at,
    source
) VALUES (?, ?, ?, ?, ?, ?);

deleteContact:
DELETE FROM contact
WHERE owner_wallet = ? AND contact_wallet = ?;

selectContactsByOwner:
SELECT * FROM contact
WHERE owner_wallet = ?
ORDER BY last_interaction_at DESC, contact_wallet ASC;

deleteStakingPositionsByWallet:
DELETE FROM staking_position
WHERE wallet_address = ?;

upsertStakingPosition:
INSERT OR REPLACE INTO staking_position(
    id,
    wallet_address,
    chain_id,
    asset_id,
    amount,
    provider_id,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectStakingPositionsByWallet:
SELECT * FROM staking_position
WHERE wallet_address = ?
ORDER BY updated_at DESC;

CREATE TABLE portfolio_cache (
    id TEXT NOT NULL PRIMARY KEY,
    wallet_address TEXT NOT NULL,
    serialized_data TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

selectPortfolioCache:
SELECT * FROM portfolio_cache
WHERE wallet_address = ?
LIMIT 1;

upsertPortfolioCache:
INSERT OR REPLACE INTO portfolio_cache(
    id,
    wallet_address,
    serialized_data,
    updated_at
) VALUES (?, ?, ?, ?);
