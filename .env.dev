# Leta Pay - Development Environment
ENV=dev

# CDP API Keys
CDP_API_KEY_ID="your-cdp-key-id"
CDP_API_KEY_SECRET="your-cdp-key-secret"
CDP_CLIENT_API_KEY="your-cdp-client-key"

# OpenAI API Keys
OPENAI_API_KEY="sk-your-openai-key"

# Ktor Backend
PORT=8080
SESSION_SECRET="dev-session-secret-at-least-32-chars-long"
REFRESH_TOKEN_PEPPER="dev-refresh-pepper"
DATABASE_URL="jdbc:postgresql://postgres:5432/letapay"
DATABASE_DRIVER="org.postgresql.Driver"
DATABASE_USER="letapay"
DATABASE_PASSWORD="letapay"
COINBASE_API_KEY="your-coinbase-api-key"
COINBASE_RISK_KEY="your-coinbase-risk-key"
AGENTKIT_SIDECAR_URL="http://agentkit-sidecar:3100"
SIDECAR_SECRET="dev-sidecar-secret"

# AgentKit Sidecar
AGENTKIT_PORT=3100
BASE_RPC_URL="https://mainnet.base.org"
ETHEREUM_RPC_URL="https://ethereum.publicnode.com"
POLYGON_RPC_URL="https://polygon-rpc.com"

# Postgres & Redis
POSTGRES_DB="letapay"
POSTGRES_USER="letapay"
POSTGRES_PASSWORD="letapay"
REDIS_URL="redis://redis:6379"
